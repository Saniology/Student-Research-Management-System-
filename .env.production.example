# Copy to the ignored repository `.env` for owner deployment work.
# Do not commit real .env files.

# Supabase project
SUPABASE_PROJECT_REF=replace_with_supabase_project_ref
SUPABASE_URL=https://replace-with-supabase-project.supabase.co

# Browser-safe values belong in the frontend environment only.
VITE_SUPABASE_URL=https://replace-with-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
VITE_PAYSTACK_PUBLIC_KEY=replace_with_paystack_public_key

# Owner-only CLI/script values. Never expose these with VITE_ prefixes.
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
# Keep private deployment keys in the owner's untracked `.env.production.local` only.
# They are intentionally omitted from this committed template.

# Edge Function secrets
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret
REPORT_CRON_SECRET=replace_with_long_random_value
HEALTH_CHECK_SECRET=replace_with_long_random_value
SIS_API_URL=https://replace-with-sis-endpoint.example
SIS_API_TOKEN=replace_with_sis_private_token

# Optional DOI issuance. Leave unset to use the manual DOI field in the library desk.
DATACITE_API_URL=https://api.datacite.org
DATACITE_PREFIX=10.replace_with_institution_prefix
DATACITE_USERNAME=replace_with_datacite_username
DATACITE_PASSWORD=replace_with_datacite_password
DATACITE_API_TOKEN=replace_with_datacite_api_token
PUBLIC_CATALOG_URL=https://replace-with-public-catalog-host.example

# Optional scheduled report email delivery
RESEND_API_KEY=replace_with_resend_api_key
REPORT_FROM_EMAIL=replace_with_report_sender_email
REPORT_DELIVERY_EMAILS=replace_with_report_recipient_emails
REPORT_LINK_TTL_SECONDS=replace_with_report_link_ttl_seconds

# Optional Cloudflare tenant DNS automation
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_dns_edit_token
CLOUDFLARE_ZONE_ID=replace_with_cloudflare_zone_id
SPMS_DNS_TARGET=cname.hosting-provider.example
SPMS_DNS_RECORD_TYPE=CNAME
SPMS_DNS_PROXIED=false
SPMS_DNS_TTL=300
