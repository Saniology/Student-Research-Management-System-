# Copy to .env.production.local for owner deployment work.
# Do not commit real .env files.

# Supabase project
SUPABASE_PROJECT_REF=tejkksgyqltudpfuzjdo
SUPABASE_URL=https://tejkksgyqltudpfuzjdo.supabase.co

# Browser-safe values belong in the frontend environment only.
VITE_SUPABASE_URL=https://tejkksgyqltudpfuzjdo.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_or_live_public_key_here

# Owner-only CLI/script values. Never expose these with VITE_ prefixes.
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
# Keep private deployment keys in the owner's untracked `.env.production.local` only.
# They are intentionally omitted from this committed template.

# Edge Function secrets
PAYSTACK_SECRET_KEY=sk_live_or_test_key_here
REPORT_CRON_SECRET=replace_with_long_random_value
HEALTH_CHECK_SECRET=replace_with_long_random_value
SIS_API_URL=https://sis.example.edu
SIS_API_TOKEN=replace_with_sis_private_token

# Optional scheduled report email delivery
RESEND_API_KEY=re_xxxxx
REPORT_FROM_EMAIL=reports@example.edu
REPORT_DELIVERY_EMAILS=registry@example.edu,finance@example.edu
REPORT_LINK_TTL_SECONDS=604800

# Optional Cloudflare tenant DNS automation
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_dns_edit_token
CLOUDFLARE_ZONE_ID=replace_with_cloudflare_zone_id
SPMS_DNS_TARGET=cname.hosting-provider.example
SPMS_DNS_RECORD_TYPE=CNAME
SPMS_DNS_PROXIED=false
SPMS_DNS_TTL=300
